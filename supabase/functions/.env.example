# Local development secrets for `supabase functions serve`.
# Copy to `.env` (git-ignored) and fill in. In production use
# `supabase secrets set KEY=value` instead of committing these.

ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional
SUMMARY_MODEL=claude-opus-5
SUMMARIZE_SHARED_SECRET=
ALLOWED_ORIGIN=*
